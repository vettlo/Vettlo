{
  "name": "vettlo-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/go/*", "/tools/*"]
  },
  // Sends form submissions through Cloudflare Email Routing. The recipient address lives in
  // the FORM_TO variable set in the Cloudflare dashboard (kept out of this public repo).
  "send_email": [{ "name": "SEND" }],
  // Vendor portal data (vendors, listings, clicks, ledger). Tables are created by src/portal.js on first use.
  "d1_databases": [{ "binding": "DB", "database_name": "vettlo", "database_id": "42829df1-e54c-426d-b625-3fd9e2851fc8" }],
  "keep_vars": true
}
